VITE_MAPBOX_ACCESS_TOKEN=pk.your_public_mapbox_token
VITE_MAPBOX_STYLE_URL=mapbox://styles/your-username/your-style-id
VITE_API_BASE_URL=http://localhost:8000

# Story backend. Local retrieval is a development-only lexical search, not TiDB.
RETRIEVAL_MODE=local
STORY_PROMPT_VERSION=2026-10-03-v1
RETRIEVAL_VERSION=ocean-education-v1
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_ATTEMPTS=2

# Gemini story generation and embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# TiDB Cloud (required only when RETRIEVAL_MODE=tidb)
TIDB_DATABASE_URL=mysql+pymysql://user:password@host:4000/database?ssl_verify_cert=true&ssl_verify_identity=true

# ElevenLabs narration
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
